# ───────────────────────────────────────────────────────────────────
# PUBLIC (NEXT_PUBLIC_*) — Exposed to browser
# ───────────────────────────────────────────────────────────────────
# These are bundled in the client JS. NEVER put secrets here.
# Anyone with DevTools can read these values.
# Store real values in .env.local (never commit it).

# Supabase client credentials (anon key is intentionally limited)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application URLs and IDs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_OWNER_PHONE=
NEXT_PUBLIC_FITGROWX_SUPPORT_WA=

# Turnstile (Cloudflare) site key for form protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push Notifications (VAPID public key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ───────────────────────────────────────────────────────────────────
# SERVER-ONLY — Never prefix these with NEXT_PUBLIC_
# ───────────────────────────────────────────────────────────────────
# Available only in API routes, server components, and middleware.
# These are secrets. Treat them with extreme care.
# Store real values in .env.local (never commit it).

# Supabase service role (full DB access — server-only!)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago payment integration
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp Motor (internal service for WhatsApp API)
WA_MOTOR_URL=
WA_MOTOR_API_KEY=
WA_MOTOR_WEBHOOK_SECRET=
WA_WEBHOOK_SECRET=

# Redis (Upstash) for caching and rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email service (Resend)
RESEND_API_KEY=

# LLM APIs
GEMINI_API_KEY=

# Turnstile secret key (server-side verification)
TURNSTILE_SECRET_KEY=

# Web Push Notifications (VAPID private key — keep secret!)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Internal authentication and security
FITGROWX_ADMIN_SECRET=
CRON_SECRET=
SHARE_CARD_SECRET=

# Contact information for alerts
ALERT_EMAIL=
ALERT_PHONE=
FITGROWX_OWNER_EMAIL=
OWNER_PHONE=

# Node environment (development, production, test)
NODE_ENV=


# ───────────────────────────────────────────────────────────────────
# CRITICAL RULES
# ───────────────────────────────────────────────────────────────────
# 1. NEVER commit .env.local with real values
# 2. NEVER prefix a secret with NEXT_PUBLIC_
# 3. If you need a value on both client and server, create TWO:
#    - NEXT_PUBLIC_FOO  (safe-to-expose subset)
#    - FOO_SECRET       (full server-side secret)
# 4. All SERVER-ONLY variables are treated as secrets
# 5. Rotate secrets regularly, especially after incidents
